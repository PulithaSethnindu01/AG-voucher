# Supabase project connection info (safe to expose to the browser - these are
# public, anonymous keys, NOT the service-role secret key).
# Get these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The "internal auth email domain" used to bridge User Number login to
# Supabase Auth's email/password system. Users never see or type this -
# it must match what is used consistently by the registration/login code.
# It does not need to be a real, reachable domain.
VITE_AUTH_EMAIL_DOMAIN=users.ag-voucher.internal
